{
  "name": "dsh-gpu-workload-manager-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "build": "pnpm -r build",
    "build:dsh-plugin": "tsc -b tsconfig.host.json && tsdown --env.DSH_BUILD_FACE=host",
    "test": "pnpm build:dsh-plugin && vitest run && deploy/test/run.sh",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "tsdown": "0.15.10",
    "typescript": "6.0.3",
    "vitest": "^3.2.0"
  }
}
